{
  "name": "auth-template",
  "version": "0.1.0",
  "description": "Reusable, framework-agnostic authentication & authorization core with an Express adapter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
